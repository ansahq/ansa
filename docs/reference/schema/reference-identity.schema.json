{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ansa.local/schema/reference-identity.schema.json",
  "title": "Ansa reference identity manifest",
  "description": "Checked schema for one frozen reference target identity. Every field that cannot be verified is explicit as state=unknown with a null value, reason and evidence_id. The schema forbids a claimed value on an unknown field.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "reference_identity_id",
    "platform",
    "state",
    "unknown_reason",
    "last_checked",
    "identity_fields",
    "capture_environment",
    "evidence_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "manifest_id": {
      "type": "string",
      "minLength": 8
    },
    "reference_identity_id": {
      "type": "string",
      "pattern": "^ref-(win|mac)-unknown-[0-9]{4}-[0-9]{2}$"
    },
    "platform": {
      "type": "string",
      "enum": [
        "windows",
        "macos"
      ]
    },
    "state": {
      "const": "unknown"
    },
    "unknown_reason": {
      "type": "string",
      "minLength": 40
    },
    "last_checked": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "identity_fields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "application",
        "os",
        "account",
        "extensions",
        "permissions"
      ],
      "properties": {
        "application": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "version",
            "build",
            "architecture",
            "artifact_sha256",
            "signature_identity",
            "signature_status"
          ],
          "properties": {
            "path": {
              "$ref": "#/$defs/unknownField"
            },
            "version": {
              "$ref": "#/$defs/unknownField"
            },
            "build": {
              "$ref": "#/$defs/unknownField"
            },
            "architecture": {
              "$ref": "#/$defs/unknownField"
            },
            "artifact_sha256": {
              "$ref": "#/$defs/unknownField"
            },
            "signature_identity": {
              "$ref": "#/$defs/unknownField"
            },
            "signature_status": {
              "$ref": "#/$defs/unknownField"
            }
          }
        },
        "os": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version",
            "build",
            "architecture"
          ],
          "properties": {
            "name": {
              "type": "string",
              "enum": [
                "Windows",
                "macOS"
              ]
            },
            "version": {
              "$ref": "#/$defs/unknownField"
            },
            "build": {
              "$ref": "#/$defs/unknownField"
            },
            "architecture": {
              "$ref": "#/$defs/unknownField"
            }
          }
        },
        "account": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tier",
            "signed_in"
          ],
          "properties": {
            "tier": {
              "$ref": "#/$defs/unknownField"
            },
            "signed_in": {
              "$ref": "#/$defs/unknownField"
            }
          }
        },
        "extensions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "$ref": "#/$defs/unknownField"
            }
          }
        },
        "permissions": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "state",
              "value",
              "reason",
              "evidence_id"
            ],
            "properties": {
              "name": {
                "type": "string",
                "enum": [
                  "accessibility",
                  "screen_recording",
                  "automation",
                  "full_disk_access",
                  "input_monitoring"
                ]
              },
              "state": {
                "type": "string",
                "enum": [
                  "unknown",
                  "known"
                ]
              },
              "value": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reason": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "evidence_id": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "state": {
                      "const": "unknown"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "value": {
                      "const": null
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 20
                    },
                    "evidence_id": {
                      "const": null
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    "capture_environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "profile_name",
        "profile_kind",
        "user_data",
        "fixtures_defined_in",
        "network_policy",
        "cleanup"
      ],
      "properties": {
        "status": {
          "const": "specified_not_created"
        },
        "profile_name": {
          "const": "ansa-reference-test-profile"
        },
        "profile_kind": {
          "const": "dedicated_test_profile"
        },
        "user_data": {
          "const": "synthetic_only"
        },
        "fixtures_defined_in": {
          "const": "docs/reference/scenario-ledger.json"
        },
        "network_policy": {
          "type": "string",
          "minLength": 20
        },
        "cleanup": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "evidence_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_app_available",
        "runtime_observations",
        "rea_tools_available",
        "rea_evidence_ids",
        "invented_observations",
        "notes"
      ],
      "properties": {
        "reference_app_available": {
          "const": false
        },
        "runtime_observations": {
          "const": 0
        },
        "rea_tools_available": {
          "const": false
        },
        "rea_evidence_ids": {
          "type": "array",
          "maxItems": 0
        },
        "invented_observations": {
          "const": false
        },
        "notes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    }
  },
  "$defs": {
    "unknownField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "value",
        "reason",
        "evidence_id"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "unknown",
            "known"
          ]
        },
        "value": {
          "type": [
            "string",
            "array",
            "null"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "const": null
              },
              "reason": {
                "type": "string",
                "minLength": 40
              },
              "evidence_id": {
                "const": null
              }
            }
          }
        }
      ]
    }
  }
}
